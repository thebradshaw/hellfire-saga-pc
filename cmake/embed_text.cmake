# Turns text files into C string constants.
#   cmake -DOUT=file.inc -DNAMES="a;b" -DFILES="x.h;y.h" -P embed_text.cmake
list(LENGTH NAMES n)
math(EXPR last "${n} - 1")
set(result "/* generated by cmake/embed_text.cmake */\n")
foreach(i RANGE ${last})
  list(GET NAMES ${i} name)
  list(GET FILES ${i} file)
  file(READ "${file}" text)
  string(REPLACE "\\" "\\\\" text "${text}")
  string(REPLACE "\"" "\\\"" text "${text}")
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE "\n" "\\n\"\n\"" text "${text}")
  string(APPEND result "static const char ${name}[] =\n\"${text}\";\n")
endforeach()
file(WRITE "${OUT}.tmp" "${result}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
